apiVersion: 1

datasources:
  - name: DefectDojo_Postgres
    type: postgres
    url: django-defectdojo-postgres-1:5432
    database: defectdojo
    user: defectdojo
    secureJsonData:
      password: "{{ dojo_db_password }}"
    jsonData:
      sslmode: 'disable'
      postgresVersion: 15
    editable: true
